{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.js",
      "*.ts",
      "*.json",
      "!src/css/theme.css",
      "!src/css/fonts-web.css",
      "!src/css/wordmark.css",
      "!src/tailwind/preset.js",
      "!src/tokens/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/tailwind/preset.js",
        "src/tokens/dist/**",
        "src/css/theme.css",
        "src/css/fonts-web.css",
        "src/css/wordmark.css"
      ],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
