{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.js",
      "*.ts",
      "*.json",
      "!src/css/theme.css",
      "!src/css/fonts-web.css",
      "!src/tailwind/preset.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["src/tailwind/preset.js", "src/css/theme.css", "src/css/fonts-web.css"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
